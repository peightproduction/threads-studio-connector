# Threads Studio: these are the settings the connector reads. On Vercel you type them in the project's
# Settings > Environment Variables (the SETUP-FULL guide walks you through it). NEVER put real values in this file or in GitHub.

# Secret part of the connector address: https://<your-domain>/mcp/<MCP_TOKEN>. Long and random (24+ characters).
MCP_TOKEN=
# Secret part of the timer address: https://<your-domain>/tick/<TICK_TOKEN>. A DIFFERENT long random value (24+ characters).
TICK_TOKEN=

# EITHER Zernio (easiest, no Meta app) ...
# From Zernio > Settings > API keys. When this is set the connector posts through Zernio and the two Meta values below are not needed.
ZERNIO_API_KEY=

# ... OR Meta's own Threads API. From your Meta app, "Access the Threads API" use case > Settings: the THREADS App ID and
# THREADS App secret (not the main Facebook app ID).
THREADS_APP_ID=
THREADS_APP_SECRET=

# Redis keeps the Threads token, your drafts, the schedule and your settings. On Vercel: Storage > Create Database > Upstash Redis,
# connect it to the project; Vercel then fills KV_REST_API_URL and KV_REST_API_TOKEN by itself (you type nothing).

# Pictures (optional): Vercel Storage > Blob (Public). Vercel fills BLOB_READ_WRITE_TOKEN.

# Optional. Only if you use your own domain; otherwise the Vercel address is used automatically.
# PUBLIC_URL=https://your-domain.example
