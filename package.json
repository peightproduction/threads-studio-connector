{
  "name": "threads-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Claude connector (MCP App) for your own Threads account: tracker, Studio tab, drafts and schedule, photo bank, winners and analytics, through Zernio (one API key) or Meta's Threads API.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:ui": "cross-env INPUT=mcp-app.html vite build",
    "embed": "tsx scripts/embed-ui.ts",
    "build": "npm run build:ui && npm run embed",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsx --env-file-if-exists=.env server.ts",
    "start": "npm run build && npm run dev"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@upstash/redis": "^1.35.0",
    "@vercel/blob": "^2.9.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "cross-env": "^10.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^3.2.4"
  },
  "license": "MIT",
  "overrides": {
    "zod": "$zod"
  }
}
